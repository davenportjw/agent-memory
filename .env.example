# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
#
# Copy this file to .env and configure values for your environment:
#   cp .env.example .env
#
# IMPORTANT SECURITY NOTICE:
# - NEVER commit .env to version control (.gitignore enforces this).
# - NEVER hardcode real API keys or credentials in files to be checked into git.
# - Google Cloud Vertex AI uses Application Default Credentials (ADC).
#   Authenticate via: gcloud auth application-default login
# ==============================================================================

# ------------------------------------------------------------------------------
# Google Cloud Platform (GCP) Configuration
# ------------------------------------------------------------------------------
# Your Google Cloud Project ID (e.g., my-project-id)
GCP_PROJECT=your-gcp-project-id
PROJECT_ID=your-gcp-project-id

# Primary Google Cloud Region for Cloud Run & Artifact Registry
GCP_REGION=us-central1

# Vertex AI Gemini Location (Must be "global", "us", or "us-central1" for Gemini 3.8 Flash)
LOCATION=global
VERTEX_LOCATION=global

# Vertex AI Model ID (Strict invariant: gemini-3.8-flash)
VERTEX_MODEL_ID=gemini-3.8-flash

# Cloud Storage Bucket for Vertex AI staging & benchmark evaluation logs
EVAL_BUCKET=your-gcp-project-id-vertex-staging
GCS_STAGING_BUCKET=your-gcp-project-id-vertex-staging

# Firestore Native database ID ('(default)' or named 'durable-memory')
FIRESTORE_DATABASE=(default)

# Memory store implementation ('memory' for in-memory or 'firestore' for Cloud Firestore)
MEMORY_STORE_TYPE=memory

# ------------------------------------------------------------------------------
# Microservice & Networking Configuration
# ------------------------------------------------------------------------------
# Port for Go Cloud Run backend service
PORT=8080

# Cloud Run Backend Endpoint URL
# Used by Flutter web client and Android emulator to connect to the backend API.
# For local development: http://localhost:8080
# For deployed Cloud Run: https://distributed-ai-backend-<hash>-<region>.a.run.app
CLOUD_BACKEND_URL=http://localhost:8080

# Maximum Edge Memory Bundle size in bytes (hard ceiling: 51200 / 50 KB)
MAX_BUNDLE_SIZE_BYTES=51200

# ------------------------------------------------------------------------------
# Optional Local Android & Toolchain Configuration
# ------------------------------------------------------------------------------
# Android SDK location (defaults to $HOME/Library/Android/sdk on macOS)
# ANDROID_HOME=/Users/your-username/Library/Android/sdk

# Java Home location (JDK 17+ required for Android SDK cmdline-tools)
# JAVA_HOME=/opt/homebrew/opt/openjdk
