#!/usr/bin/env bash
set -e
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Source .env if present
if [ -f "${ROOT_DIR}/.env" ]; then
    set -a
    # shellcheck disable=SC1091
    source "${ROOT_DIR}/.env"
    set +a
fi

# Prefer project flutter SDK if installed, otherwise fallback to system flutter
if [ -x "${ROOT_DIR}/.flutter_sdk/bin/flutter" ]; then
    export HOME="${ROOT_DIR}/.tmp_home"
    export PUB_CACHE="${ROOT_DIR}/.tmp_home/.pub-cache"
    exec "${ROOT_DIR}/.flutter_sdk/bin/flutter" "$@"
elif command -v flutter >/dev/null 2>&1; then
    exec flutter "$@"
else
    echo "Error: Flutter SDK not found. Please install Flutter or run setup." >&2
    exit 1
fi
