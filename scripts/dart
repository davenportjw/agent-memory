#!/usr/bin/env bash
set -e
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Source .env if present
if [ -f "${ROOT_DIR}/.env" ]; then
    set -a
    # shellcheck disable=SC1091
    source "${ROOT_DIR}/.env"
    set +a
fi

# If running flutter tests that require flutter runtime/dart:ui, delegate to flutter test
if [[ "${*:-}" == *"test/"*".dart"* ]]; then
    cd "${ROOT_DIR}/client"
    # Extract relative path to test file from client/
    TEST_FILE="${1}"
    TEST_FILE="${TEST_FILE#client/}"
    exec "${ROOT_DIR}/scripts/flutter" test "${TEST_FILE}"
fi

if [ -x "${ROOT_DIR}/.flutter_sdk/bin/cache/dart-sdk/bin/dart" ]; then
    export HOME="${ROOT_DIR}/.tmp_home"
    export PUB_CACHE="${ROOT_DIR}/.tmp_home/.pub-cache"
    exec "${ROOT_DIR}/.flutter_sdk/bin/cache/dart-sdk/bin/dart" "$@"
elif command -v dart >/dev/null 2>&1; then
    exec dart "$@"
else
    echo "Error: Dart SDK not found." >&2
    exit 1
fi
