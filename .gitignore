# ==============================================================================
# Root .gitignore - Multi-Agent Madness / Distributed AI
# ==============================================================================

# Environment variables & secrets (CRITICAL)
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*service-account*.json
credentials.json

# Local toolchains & temporary home directories
.flutter_sdk/
.tmp_home/

# macOS / OS metadata
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes

# IDE & Editor files
**/.idea/
**/.vscode/
*.iml
*.ipr
*.iws
*.swp
*.swo
*~

# Flutter / Dart build artifacts & cache
**/doc/api/
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.pub-cache/
**/.pub/
**/build/
**/coverage/
*.log
flutter_*.log

# Android Studio / Gradle outputs
**/android/.gradle/
**/android/local.properties
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
*.apk
*.aab

# Go build outputs & binaries
server/server
server/tmp_evals/
*.exe
*.test
bin/

# Terraform state & cache
terraform/.terraform/
terraform/.terraform.lock.hcl
terraform/*.tfstate
terraform/*.tfstate.*
terraform/terraform.tfvars
terraform/tfplan*

# Node / NPM
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
