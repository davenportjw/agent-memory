{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "1.0.0",
  "title": "DurableMemoryPipelineSchema",
  "definitions": {
    "EpisodicTurn": {
      "type": "object",
      "required": ["id", "session_id", "timestamp", "user_prompt", "model_response", "route", "entities_extracted"],
      "properties": {
        "id": { "type": "string" },
        "session_id": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "user_prompt": { "type": "string" },
        "model_response": { "type": "string" },
        "route": { "type": "string", "enum": ["EDGE_LOCAL", "EDGE_FALLBACK", "CLOUD_ESCALATE"] },
        "model_name": { "type": "string" },
        "latency_ms": { "type": "integer" },
        "ttft_ms": { "type": "integer" },
        "is_pii_sanitized": { "type": "boolean" },
        "entities_extracted": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["entity_type", "entity_value"],
            "properties": {
              "entity_type": { "type": "string" },
              "entity_value": { "type": "string" },
              "confidence": { "type": "number" }
            }
          }
        }
      }
    },
    "DurableKnowledgeNode": {
      "type": "object",
      "required": ["id", "entity_name", "category", "summary", "confidence", "source_episode_ids", "last_updated"],
      "properties": {
        "id": { "type": "string" },
        "entity_name": { "type": "string" },
        "category": { "type": "string", "enum": ["USER_PREFERENCE", "SYSTEM_ARCHITECTURE", "ROADMAP_DECISION", "SECURITY_POLICY", "FACTION_STATE", "NPC_RELATION", "WORLD_EVENT", "LORE_CANON"] },
        "summary": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "relations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "predicate": { "type": "string" },
              "target_node_id": { "type": "string" }
            }
          }
        },
        "source_episode_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "resolved_contradictions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "last_updated": { "type": "string", "format": "date-time" }
      }
    },
    "CompactEdgeMemoryBundle": {
      "type": "object",
      "required": ["bundle_version", "created_at", "total_anchors", "size_bytes", "anchors"],
      "properties": {
        "bundle_version": { "type": "integer" },
        "created_at": { "type": "string", "format": "date-time" },
        "total_anchors": { "type": "integer" },
        "size_bytes": { "type": "integer", "maximum": 51200 },
        "anchors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["anchor_id", "key", "distilled_context"],
            "properties": {
              "anchor_id": { "type": "string" },
              "key": { "type": "string" },
              "category": { "type": "string" },
              "distilled_context": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
